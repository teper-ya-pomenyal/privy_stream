
//
Users(User Service) {
    user_id UUID PK
    user_name STRING
    password_hash STRING
    birth_date DATETIME
    created_at DATETIME
}


//
Artists(Catalog Service) {
    id_artist UUID PK
    artist_name STRING
    created_at DATETIME
}

//
Albums(CatalogService) {
    id_album UUID PK
    id_artist UUID FK
    album_name STRING
    created_at DATETIME
}

//
Tracks(Catalog Service) {
    id_track UUID PK
    track_name STRING
    id_artist UUID FK
    id_album UUID FK
    explicit BOOLEAN
    path STRING
    created_at DATETIME
}

//
Playlists(Catalog Service) {
    id_playlist UUID PK
    playlist_name STRING
    id_owner UUID (NOT FK, OTHER DB)
    created_at DATETIME
}


//
PlaylistTrack(CatalogService) {
    (PRIMARY KEY id_playlist + id_track)
    id_playlist UUID PK
    id_track UUID PK
    position INTEGER
    added_at DATETIME
}



